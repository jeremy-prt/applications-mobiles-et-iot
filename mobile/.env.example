# Adresse de l'API, vue depuis le téléphone.
# localhost désignerait le téléphone lui-même : il faut l'adresse IP de la
# machine qui fait tourner le backend, sur le réseau local.
# Sur macOS : ipconfig getifaddr en0
# Sur Windows : ipconfig, puis l'adresse IPv4 de la carte Wi-Fi
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
