# Copier ce fichier en .env avant de lancer le projet.
# Aucune de ces valeurs n'est un secret de production.

# Base de données
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-local

# Comptes du kit fourni, voir infra/kit/README.md
SIMULATOR_PASSWORD=simulator-demo
BACKEND_PASSWORD=backend-demo
TEACHER_PASSWORD=teacher-demo

# Port MQTT publié sur la machine, à changer si 1883 est déjà pris
MQTT_PORT=1883

# Intervalle de publication des capteurs simulés, en secondes
PUBLISH_INTERVAL=2

# Clé de signature des jetons. En production ce serait un secret généré.
JWT_SECRET=changez-moi-en-local
