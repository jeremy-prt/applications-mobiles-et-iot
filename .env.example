# Copier ce fichier en .env avant de lancer le projet.
# Aucune de ces valeurs n'est un secret de production.

# Base consolidée
POSTGRES_DB=campus
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus-local

# Zone brute. Pas d'authentification : le port n'est ouvert que sur cette machine,
# comme PostgreSQL.
MONGO_DB=campus_brut

# Comptes du kit fourni, voir infra/kit/README.md
SIMULATOR_PASSWORD=simulator-demo
BACKEND_PASSWORD=backend-demo
TEACHER_PASSWORD=teacher-demo

# Port MQTT publié sur la machine, à changer si 1883 est déjà pris
MQTT_PORT=1883

# Intervalle de publication des capteurs simulés, en secondes
PUBLISH_INTERVAL=2

# Clé de signature des jetons. En production ce serait un secret généré.
JWT_SECRET=changez-moi-en-local

# Interface locale de centralisation des logs
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# QoS des abonnements MQTT du backend, 0 ou 1. Sert au scénario de comparaison de J3.
MQTT_QOS=1

# Port de l'API publié sur la machine, à changer si 3000 est déjà pris. C'est le
# seul port ouvert au réseau local, parce que le téléphone doit l'atteindre.
API_PORT=3000

# Nom du projet Compose. Il doit rester le même pour les deux fichiers Compose,
# sinon le kit démarre un second projet qui échoue sur le port 1883 déjà pris.
COMPOSE_PROJECT_NAME=applications-mobiles-et-iot

# Niveau de détail des traces du backend : debug, info, warn ou error.
LOG_LEVEL=info
