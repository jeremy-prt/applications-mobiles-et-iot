    {
      "id": 10,
      "type": "stat",
      "title": "Mesures enregistrées",
      "description": "Nombre de mesures entrées en base sur la période choisie en haut à droite. Les trois capteurs publient toutes les 2 secondes, donc environ 90 par minute quand tout va bien. Un zéro veut dire que plus rien n'arrive.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"backend\"} | json | eventType=\"mesure_enregistree\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
